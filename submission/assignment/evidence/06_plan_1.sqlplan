<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT TOP (15) i.InvoiceNumber,&#xa;    (SELECT sp.StudentNumber FROM [identity].StudentProfiles AS sp WHERE sp.Id = i.StudentId) AS StudentNumber,&#xa;    i.TotalAmount - i.PaidAmount AS Remaining,&#xa;    CASE WHEN i.DueAtUtc &lt; DATEADD(DAY, -60, SYSUTCDATETIME()) THEN &apos;Urgent&apos; ELSE &apos;Normal&apos; END AS Urgency&#xa;FROM finance.Invoices AS i&#xa;WHERE i.PaidAmount &lt; i.TotalAmount AND i.DueAtUtc &lt; SYSUTCDATETIME()&#xa;ORDER BY Remaining DESC" StatementId="1" StatementCompId="4" StatementType="SELECT" RetrievedFromCache="true" StatementSubTreeCost="2.38096" StatementEstRows="15" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x596948F3E55FC01E" QueryPlanHash="0x8E4DEB211597C9DE" CardinalityEstimationModelVersion="150"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="8" MemoryGrant="11712" CachedPlanSize="56" CompileTime="5" CompileCPU="5" CompileMemory="648"><ThreadStat Branches="1" UsedThreads="8"><ThreadReservation NodeId="0" ReservedThreads="8"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="65.7547"><MissingIndex Database="[Assignment3_Practice_20261127]" Schema="[finance]" Table="[Invoices]"><ColumnGroup Usage="INEQUALITY"><Column Name="[DueAtUtc]" ColumnId="8"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[InvoiceNumber]" ColumnId="2"></Column><Column Name="[StudentId]" ColumnId="3"></Column><Column Name="[TotalAmount]" ColumnId="9"></Column><Column Name="[PaidAmount]" ColumnId="10"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="512" SerialDesiredMem